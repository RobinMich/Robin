// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// © Robin - Unified Multi-Strategy v1.0
// Combines: Deep Pullback Recovery (A) + Trend Continuation (B) + Fractal Breakout (C)
// Signal Confluence boost, Unified Exit System, Anti-Overextension

//@version=6
strategy("Robin Unified v1.0 | DeepPB + TrendRide + Fractal",
     overlay=true, initial_capital=10000, pyramiding=3,
     commission_type=strategy.commission.percent, commission_value=0.0)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE SELECTION                                                  ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_modes = "Mode Selection"
enableA = input.bool(true, "Mode A: Deep Pullback Recovery (Long)", group=grp_modes)
enableB = input.bool(true, "Mode B: Trend Continuation (L+S)", group=grp_modes)
enableC = input.bool(true, "Mode C: Fractal Breakout (L+S)", group=grp_modes)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  SHARED INPUTS                                                   ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_tf = "Timeframes"
tfD = input.timeframe("D", "Daily TF", group=grp_tf)
tfW = input.timeframe("W", "Weekly TF", group=grp_tf)

grp_w = "Weekly Context"
wEma5Len  = input.int(5,  "W EMA5", minval=1, group=grp_w)
wEma50Len = input.int(50, "W EMA50", minval=1, group=grp_w)
wAtrLen   = input.int(14, "W ATR len", minval=1, group=grp_w)

grp_d = "Daily Context"
dEma10Len = input.int(10, "D EMA10", minval=1, group=grp_d)
dEma20Len = input.int(20, "D EMA20", minval=1, group=grp_d)
dAtrLen   = input.int(14, "D ATR len", minval=1, group=grp_d)

grp_h2 = "H2 Indicators"
h2Ema10Len = input.int(10, "H2 EMA10", minval=1, group=grp_h2)
h2Ema20Len = input.int(20, "H2 EMA20", minval=1, group=grp_h2)
h2AtrLen   = input.int(14, "H2 ATR len", minval=1, group=grp_h2)

grp_ext = "Anti-Overextension"
useAntiExt = input.bool(true, "Anti-Overextension", group=grp_ext)
maxExtATR  = input.float(2.0, "Max dist D EMA10 (in D ATR)", minval=0.5, group=grp_ext)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE A INPUTS                                                   ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_a = "Mode A: Deep Pullback"
mA_ddPct       = input.float(10.0, "A: DD from ATH (%)", minval=0.0, group=grp_a)
mA_atrMult     = input.float(1.0, "A: Close<=EMA50-x*W_ATR", minval=0.0, group=grp_a)
mA_crossLB     = input.int(25, "A: Cross within N daily bars", minval=1, group=grp_a)
mA_pbMaxDays   = input.int(30, "A: PB within N days after cross", minval=3, group=grp_a)
mA_needTouch   = input.bool(true, "A: PB must touch EMA zone", group=grp_a)
mA_reqAbove20  = input.bool(true, "A: Require D close>=EMA20", group=grp_a)
mA_pivotLen    = input.int(8, "A: Pivot lookback", minval=2, group=grp_a)
mA_entryBuf    = input.float(0.06, "A: Entry buffer x*H2_ATR", minval=0.0, group=grp_a)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE B INPUTS                                                   ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_b = "Mode B: Trend Continuation"
mB_mode     = input.string("Both", "B: Entry mode", options=["Both","PBD+Breakout","PBD+Reclaim"], group=grp_b)
mB_pbdDays  = input.int(7, "B: PBD window (D bars)", minval=1, group=grp_b)
mB_reclaim  = input.bool(true, "B: Require reclaim", group=grp_b)
mB_emaZone  = input.bool(true, "B: PBD into EMA zone", group=grp_b)
mB_boLB     = input.int(7, "B: Breakout lookback (H2)", minval=2, group=grp_b)
mB_adxLen   = input.int(14, "B: ADX len", minval=1, group=grp_b)
mB_adxMin   = input.float(20.0, "B: ADX min base", minval=5.0, group=grp_b)
mB_adxStrong = input.float(16.0, "B: ADX min strong", minval=5.0, group=grp_b)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE C INPUTS                                                   ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_c = "Mode C: Fractal Breakout"
mC_fracLB    = input.int(2, "C: Fractal lookback", minval=1, maxval=5, group=grp_c)
mC_maxFrac   = input.int(30, "C: Max bars for fractal", minval=1, group=grp_c)
mC_distFilt  = input.bool(true, "C: Distance filter", group=grp_c)
mC_maxDist   = input.float(5.0, "C: Max fractal dist (%)", minval=0.1, group=grp_c)
mC_slMode    = input.string("Volles Fractal", "C: SL mode", options=["Volles Fractal","Halber Abstand"], group=grp_c)
mC_maxPend   = input.int(30, "C: Max bars pending", minval=1, group=grp_c)
mC_maxEntDist = input.float(10.0, "C: Max entry dist (%)", minval=1.0, group=grp_c)
mC_long      = input.bool(true, "C: Long trades", group=grp_c)
mC_short     = input.bool(true, "C: Short trades", group=grp_c)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  RISK / SIZING / CONFLUENCE                                      ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_risk = "Risk & Sizing"
basePct      = input.float(7.0, "Base position % equity", minval=0.1, group=grp_risk)
regBoost     = input.float(1.3, "Regime boost (strong trend)", minval=1.0, group=grp_risk)
wGapMin      = input.float(0.8, "Strong: |W5-W50|>=x*W_ATR", minval=0.0, group=grp_risk)
confBoost    = input.float(1.5, "Confluence boost (x)", minval=1.0, maxval=3.0, group=grp_risk)

grp_addon = "Add-Ons"
add1Pct      = input.float(10.0, "Add1 % equity @+1R", minval=0.0, group=grp_addon)
add2Pct      = input.float(6.0, "Add2 % equity @+2R", minval=0.0, group=grp_addon)
add2Strong   = input.bool(true, "Add2 only strong trend", group=grp_addon)
lockOnAdd    = input.bool(true, "Stop-lock on Add1", group=grp_addon)
lockExtraR   = input.float(0.0, "Lock level: BE + extra R", minval=0.0, group=grp_addon)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  EXIT INPUTS                                                     ║
// ╚══════════════════════════════════════════════════════════════════╝
grp_exit = "Exit Management"
stopAtrX     = input.float(1.5, "Initial stop x*H2_ATR", minval=0.5, group=grp_exit)
stopPadX     = input.float(0.25, "Stop pad x*H2_ATR", minval=0.0, group=grp_exit)
beAfterR     = input.float(1.0, "BE after R", minval=0.1, group=grp_exit)
bePlusR      = input.float(0.0, "BE + extra R", minval=0.0, group=grp_exit)
beAtrBuf     = input.float(0.3, "BE ATR buffer", minval=0.0, group=grp_exit)
bePBBreak    = input.bool(true, "BE on PB-high break", group=grp_exit)
trailR       = input.float(2.8, "Trail start R", minval=0.5, group=grp_exit)
trailAtrX    = input.float(3.0, "Chandelier trail x*H2_ATR", minval=0.5, group=grp_exit)
nearAthPct   = input.float(2.0, "Near ATH (%): tighten", minval=0.0, group=grp_exit)
tightAtrX    = input.float(2.6, "Tight trail x*H2_ATR", minval=0.5, group=grp_exit)
doPartial    = input.bool(true, "Partial TP @1R", group=grp_exit)
partPct      = input.float(50.0, "Partial TP %", minval=10, maxval=90, group=grp_exit)
tsBars       = input.int(80, "TimeStop H2 bars (no +1R)", minval=10, group=grp_exit)

grp_sess = "Session"
useSess   = input.bool(false, "Session filter", group=grp_sess)
sessS     = input.int(8, "Start UTC", minval=0, maxval=23, group=grp_sess)
sessE     = input.int(20, "End UTC", minval=0, maxval=23, group=grp_sess)

grp_disp = "Display"
showPanel = input.bool(true, "Show panel", group=grp_disp)
logOn     = input.bool(true, "Enable logs", group=grp_disp)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  SESSION                                                         ║
// ╚══════════════════════════════════════════════════════════════════╝
cHour = hour(time, "UTC")
inSess = not useSess or (cHour >= sessS and cHour < sessE)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MTF DATA (H2=native, D+W=request.security)                     ║
// ╚══════════════════════════════════════════════════════════════════╝
h2Atr   = ta.atr(h2AtrLen)
h2Ema10 = ta.ema(close, h2Ema10Len)
h2Ema20 = ta.ema(close, h2Ema20Len)

dClose = request.security(syminfo.tickerid, tfD, close, barmerge.gaps_off, barmerge.lookahead_off)
dHigh  = request.security(syminfo.tickerid, tfD, high,  barmerge.gaps_off, barmerge.lookahead_off)
dLow   = request.security(syminfo.tickerid, tfD, low,   barmerge.gaps_off, barmerge.lookahead_off)
dEma10 = request.security(syminfo.tickerid, tfD, ta.ema(close, dEma10Len), barmerge.gaps_off, barmerge.lookahead_off)
dEma20 = request.security(syminfo.tickerid, tfD, ta.ema(close, dEma20Len), barmerge.gaps_off, barmerge.lookahead_off)
dAtr   = request.security(syminfo.tickerid, tfD, ta.atr(dAtrLen), barmerge.gaps_off, barmerge.lookahead_off)
dCrossUp = request.security(syminfo.tickerid, tfD, ta.crossover(ta.ema(close, dEma10Len), ta.ema(close, dEma20Len)), barmerge.gaps_off, barmerge.lookahead_off)
dBarsCross = request.security(syminfo.tickerid, tfD, ta.barssince(ta.crossover(ta.ema(close, dEma10Len), ta.ema(close, dEma20Len))), barmerge.gaps_off, barmerge.lookahead_off)

wClose = request.security(syminfo.tickerid, tfW, close, barmerge.gaps_off, barmerge.lookahead_off)
wHigh  = request.security(syminfo.tickerid, tfW, high,  barmerge.gaps_off, barmerge.lookahead_off)
wEma5  = request.security(syminfo.tickerid, tfW, ta.ema(close, wEma5Len),  barmerge.gaps_off, barmerge.lookahead_off)
wEma50 = request.security(syminfo.tickerid, tfW, ta.ema(close, wEma50Len), barmerge.gaps_off, barmerge.lookahead_off)
wAtr   = request.security(syminfo.tickerid, tfW, ta.atr(wAtrLen), barmerge.gaps_off, barmerge.lookahead_off)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  SHARED TREND CONTEXT                                            ║
// ╚══════════════════════════════════════════════════════════════════╝
wLongOK  = wEma5 > wEma50
wShortOK = wEma5 < wEma50
dLongOK  = dEma10 > dEma20
dShortOK = dEma10 < dEma20

wGap = math.abs(wEma5 - wEma50)
strong = wAtr > 0 ? (wGap >= wGapMin * wAtr) : false
sMult  = strong ? regBoost : 1.0

var float wATH = na
wATH := na(wATH) ? wHigh : math.max(wATH, wHigh)
dAthPct = (wATH != 0) ? ((wATH - close) / wATH) * 100.0 : 999.0

extLongOK  = not useAntiExt or (math.abs(dClose - dEma10) <= maxExtATR * dAtr)
extShortOK = not useAntiExt or (math.abs(dClose - dEma10) <= maxExtATR * dAtr)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE A: DEEP PULLBACK RECOVERY (Long Only)                      ║
// ╚══════════════════════════════════════════════════════════════════╝
wDdPct = wATH != 0 ? ((wATH - wClose) / wATH) * 100.0 : 0.0
wDeepDD  = wDdPct >= mA_ddPct
wDeepATR = wClose <= (wEma50 - mA_atrMult * wAtr)
wDeep    = wDeepDD or wDeepATR

crossRec = (dBarsCross >= 0) and (dBarsCross <= mA_crossLB)
zTop = math.max(dEma10, dEma20)
zBot = math.min(dEma10, dEma20)
touched = (dLow <= zTop) and (dHigh >= zBot)
pbWinOK = crossRec and (dBarsCross <= mA_pbMaxDays)
dPBok   = pbWinOK and (not mA_needTouch or touched)
dValid  = (not mA_reqAbove20) or (dClose >= dEma20)

pivH2 = ta.highest(high, mA_pivotLen)
aEntryPx = pivH2 + mA_entryBuf * h2Atr

var bool  aWkDeep   = false
var bool  aDCross   = false
var bool  aDPb      = false
var float aPbLow    = na
var float aPbHigh   = na
var int   aPbAge    = 0

isFlat = strategy.position_size == 0

if enableA and isFlat
    if not aWkDeep and wDeep
        aWkDeep := true
        aDCross := false
        aDPb    := false
        aPbLow  := na
        aPbHigh := na
        aPbAge  := 0
        if logOn
            log.info("A: WK DEEP | DD%={0} ATH={1}", str.tostring(wDdPct, "#.##"), str.tostring(wATH, format.mintick))

    if aWkDeep and not aDCross and dCrossUp
        aDCross := true
        aDPb    := false
        aPbLow  := na
        aPbHigh := na
        aPbAge  := 0

    if aWkDeep and aDCross and not aDPb and dPBok
        aDPb    := true
        aPbLow  := low
        aPbHigh := high
        aPbAge  := 0

    if aDCross and (dBarsCross > mA_pbMaxDays)
        aWkDeep := false
        aDCross := false
        aDPb    := false

if enableA and isFlat and aDPb
    aPbAge += 1
    aPbLow  := na(aPbLow) ? low : math.min(aPbLow, low)
    aPbHigh := na(aPbHigh) ? high : math.max(aPbHigh, high)
    if aPbAge > 180
        aWkDeep := false
        aDCross := false
        aDPb    := false

aReady = enableA and isFlat and aWkDeep and aDCross and aDPb and (close > h2Ema20) and dValid and extLongOK and inSess

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE B: TREND CONTINUATION (Long + Short)                       ║
// ╚══════════════════════════════════════════════════════════════════╝
// PBD Long
pbTouchL = ta.lowest(dLow - dEma10, mB_pbdDays) <= 0
pbZoneL  = ta.lowest(dLow - math.min(dEma10, dEma20), mB_pbdDays) <= 0 and ta.highest(dLow - math.max(dEma10, dEma20), mB_pbdDays) <= 0
pbdL     = mB_emaZone ? pbZoneL : pbTouchL
rclL     = not mB_reclaim or (dClose > dEma10)

// PBD Short
pbTouchS = ta.highest(dHigh - dEma10, mB_pbdDays) >= 0
pbZoneS  = ta.highest(dHigh - math.max(dEma10, dEma20), mB_pbdDays) >= 0 and ta.lowest(dHigh - math.min(dEma10, dEma20), mB_pbdDays) >= 0
pbdS     = mB_emaZone ? pbZoneS : pbTouchS
rclS     = not mB_reclaim or (dClose < dEma10)

// ADX (H2 manual)
tTR = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
tUp   = high - high[1]
tDown = low[1] - low
tPDM  = (tUp > tDown and tUp > 0) ? tUp : 0.0
tMDM  = (tDown > tUp and tDown > 0) ? tDown : 0.0
tRma  = ta.rma(tTR, mB_adxLen)
tPRma = ta.rma(tPDM, mB_adxLen)
tMRma = ta.rma(tMDM, mB_adxLen)
tPDI  = tRma != 0 ? 100 * (tPRma / tRma) : 0.0
tMDI  = tRma != 0 ? 100 * (tMRma / tRma) : 0.0
tDen  = tPDI + tMDI
tDx   = tDen != 0 ? 100 * math.abs(tPDI - tMDI) / tDen : 0.0
tAdx  = ta.rma(tDx, mB_adxLen)
adxTh = strong ? mB_adxStrong : mB_adxMin
adxOK = tAdx >= adxTh

// Breakout
hhB = ta.highest(high, mB_boLB)
llB = ta.lowest(low, mB_boLB)
boOK = close > hhB[1]
bdOK = close < llB[1]

useBO = mB_mode == "Both" or mB_mode == "PBD+Breakout"
useRC = mB_mode == "Both" or mB_mode == "PBD+Reclaim"

bLongA  = wLongOK and dLongOK and pbdL and rclL and extLongOK and adxOK and boOK
bLongB  = wLongOK and dLongOK and pbdL and rclL and extLongOK and adxOK
bShortA = wShortOK and dShortOK and pbdS and rclS and extShortOK and adxOK and bdOK
bShortB = wShortOK and dShortOK and pbdS and rclS and extShortOK and adxOK

bLong  = enableB and isFlat and inSess and ((useBO and bLongA) or (useRC and bLongB))
bShort = enableB and isFlat and inSess and ((useBO and bShortA) or (useRC and bShortB))

// ╔══════════════════════════════════════════════════════════════════╗
// ║  MODE C: FRACTAL BREAKOUT (Long + Short)                         ║
// ╚══════════════════════════════════════════════════════════════════╝
is_fh(n) =>
    r = true
    for i = 1 to n
        if high[n] <= high[n - i] or high[n] <= high[n + i]
            r := false
    r

is_fl(n) =>
    r = true
    for i = 1 to n
        if low[n] >= low[n - i] or low[n] >= low[n + i]
            r := false
    r

fhDet = is_fh(mC_fracLB)
flDet = is_fl(mC_fracLB)
fhPx  = fhDet ? high[mC_fracLB] : na
flPx  = flDet ? low[mC_fracLB] : na

htfBull = wLongOK and dLongOK
htfBear = wShortOK and dShortOK
cxAbove = close > h2Ema20 and close[1] <= h2Ema20[1]
cxBelow = close < h2Ema20 and close[1] >= h2Ema20[1]

cSetupL = mC_long  and htfBull and h2Ema10 < h2Ema20 and cxAbove and inSess and extLongOK
cSetupS = mC_short and htfBear and h2Ema10 > h2Ema20 and cxBelow and inSess and extShortOK

var int   cBarsSetup = na
var bool  cWaiting   = false
var int   cDir       = 0
var float cEntryPx   = na
var float cSlPx      = na
var float cLastFL    = na
var float cLastFH    = na
var bool  cPend      = false
var int   cPendBars  = 0
var float cInitRisk  = na

if flDet
    cLastFL := flPx
if fhDet
    cLastFH := fhPx

if enableC and cSetupL and not cWaiting and isFlat and not cPend
    cWaiting   := true
    cBarsSetup := 0
    cDir       := 1

if enableC and cSetupS and not cWaiting and isFlat and not cPend
    cWaiting   := true
    cBarsSetup := 0
    cDir       := -1

if cWaiting
    cBarsSetup += 1
if cWaiting and cBarsSetup > mC_maxFrac
    cWaiting   := false
    cBarsSetup := na
    cDir       := 0

// Fractal -> set pending (LONG)
if cWaiting and cDir == 1 and fhDet and cBarsSetup <= mC_maxFrac
    dp = math.abs(fhPx - h2Ema20) / h2Ema20 * 100
    if not mC_distFilt or dp <= mC_maxDist
        cEntryPx := fhPx
        cSlPx    := mC_slMode == "Volles Fractal" ? cLastFL : cEntryPx - (cEntryPx - cLastFL) / 2
        if not na(cSlPx) and cSlPx < cEntryPx
            cPend      := true
            cPendBars  := 0
            cWaiting   := false
            cBarsSetup := na
            cInitRisk  := cEntryPx - cSlPx

// Fractal -> set pending (SHORT)
if cWaiting and cDir == -1 and flDet and cBarsSetup <= mC_maxFrac
    dp = math.abs(flPx - h2Ema20) / h2Ema20 * 100
    if not mC_distFilt or dp <= mC_maxDist
        cEntryPx := flPx
        cSlPx    := mC_slMode == "Volles Fractal" ? cLastFH : cEntryPx + (cLastFH - cEntryPx) / 2
        if not na(cSlPx) and cSlPx > cEntryPx
            cPend      := true
            cPendBars  := 0
            cWaiting   := false
            cBarsSetup := na
            cInitRisk  := cSlPx - cEntryPx

// Pending expiry
if cPend and isFlat
    cPendBars += 1
    cancelHTF = (cDir == 1 and not htfBull) or (cDir == -1 and not htfBear)
    cancelTO  = cPendBars > mC_maxPend
    eDist     = math.abs(cEntryPx - close) / close * 100
    cancelD   = cPendBars > 5 and eDist > mC_maxEntDist
    if cancelHTF or cancelTO or cancelD
        strategy.cancel_all()
        cPend     := false
        cPendBars := 0
        cEntryPx  := na
        cSlPx     := na
        cDir      := 0

// ╔══════════════════════════════════════════════════════════════════╗
// ║  CONFLUENCE & SIZING                                             ║
// ╚══════════════════════════════════════════════════════════════════╝
lModes = (aReady ? 1 : 0) + (bLong ? 1 : 0) + ((cPend or cWaiting) and cDir == 1 ? 1 : 0)
sModes = (bShort ? 1 : 0) + ((cPend or cWaiting) and cDir == -1 ? 1 : 0)
cBoost = (lModes >= 2 or sModes >= 2) ? confBoost : 1.0

effPct  = basePct * sMult * cBoost
baseQty = (strategy.equity * (effPct / 100.0)) / close
a1Qty   = (strategy.equity * (add1Pct * sMult / 100.0)) / close
a2Qty   = (strategy.equity * (add2Pct * sMult / 100.0)) / close

// ╔══════════════════════════════════════════════════════════════════╗
// ║  POSITION STATE                                                  ║
// ╚══════════════════════════════════════════════════════════════════╝
var int   eSrc    = 0      // 0=none 1=A 2=B 3=C
var float anchor  = na
var float aR      = na
var float sPx     = na
var float hiS     = na
var float loS     = na
var int   bIn     = 0
var bool  did1    = false
var bool  did2    = false
var float pbBrk   = na
var bool  beOn    = false
var bool  partOK  = false
var bool  aPend   = false  // Mode A pending stop order

anyPend = aPend or cPend

// ╔══════════════════════════════════════════════════════════════════╗
// ║  ENTRIES (Priority: B market > A stop > C stop)                  ║
// ╚══════════════════════════════════════════════════════════════════╝

// --- Mode B: Market entry (highest priority) ---
if bLong
    if aPend or cPend
        strategy.cancel_all()
        aPend := false
        cPend := false
        cDir  := 0
        cPendBars := 0
    anchor  := close
    aR      := stopAtrX * h2Atr
    sPx     := anchor - aR
    hiS     := high
    loS     := low
    bIn     := 0
    did1    := false
    did2    := false
    beOn    := false
    partOK  := false
    pbBrk   := na
    eSrc    := 2
    strategy.entry("L", strategy.long, qty=baseQty)
    if logOn
        log.info("B: LONG @ {0} | strong={1} conf={2}", str.tostring(close, format.mintick), str.tostring(strong), str.tostring(lModes))

if bShort and not bLong
    if aPend or cPend
        strategy.cancel_all()
        aPend := false
        cPend := false
        cDir  := 0
        cPendBars := 0
    anchor  := close
    aR      := stopAtrX * h2Atr
    sPx     := anchor + aR
    hiS     := high
    loS     := low
    bIn     := 0
    did1    := false
    did2    := false
    beOn    := false
    partOK  := false
    pbBrk   := na
    eSrc    := 2
    strategy.entry("S", strategy.short, qty=baseQty)
    if logOn
        log.info("B: SHORT @ {0} | strong={1} conf={2}", str.tostring(close, format.mintick), str.tostring(strong), str.tostring(sModes))

// --- Mode A: Stop order at pivot (second priority, long only) ---
if aReady and not bLong and not bShort and not cPend
    strategy.entry("L", strategy.long, qty=baseQty, stop=aEntryPx)
    if not aPend
        aPend := true
        eSrc  := 1
        if logOn
            log.info("A: STOP ORDER @ {0} | PBlow={1}", str.tostring(aEntryPx, format.mintick), not na(aPbLow) ? str.tostring(aPbLow, format.mintick) : "na")

// Cancel Mode A if conditions no longer valid
if aPend and not aReady and isFlat
    strategy.cancel("L")
    aPend := false
    if eSrc == 1
        eSrc := 0

// --- Mode C: Pending stop order (third priority) ---
if cPend and isFlat and not bLong and not bShort and not aPend
    rAmt = strategy.equity * (effPct / 100.0)
    slD  = math.abs(cEntryPx - cSlPx)
    cQty = slD > 0 ? rAmt / (slD * syminfo.pointvalue) : baseQty
    if cQty <= 0
        cQty := baseQty
    if cDir == 1 and cQty > 0
        strategy.entry("L", strategy.long, qty=cQty, stop=cEntryPx)
        eSrc := 3
    if cDir == -1 and cQty > 0
        strategy.entry("S", strategy.short, qty=cQty, stop=cEntryPx)
        eSrc := 3

// ╔══════════════════════════════════════════════════════════════════╗
// ║  FILL DETECTION                                                  ║
// ╚══════════════════════════════════════════════════════════════════╝
pSign = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
var int prevPS = 0
newFill = (prevPS == 0 and pSign != 0)
prevPS := pSign

if newFill
    anchor := strategy.position_avg_price
    hiS    := high
    loS    := low
    bIn    := 0
    did1   := false
    did2   := false
    beOn   := false
    partOK := false

    if eSrc == 1  // Mode A fill
        sPx   := nz(aPbLow, anchor - stopAtrX * h2Atr) - stopPadX * h2Atr
        aR    := math.abs(anchor - sPx)
        pbBrk := aPbHigh
        aPend := false
        aWkDeep := false
        aDCross := false
        aDPb    := false
        aPbAge  := 0
        if logOn
            log.info("A: FILLED @ {0} stop={1}", str.tostring(anchor, format.mintick), str.tostring(sPx, format.mintick))

    else if eSrc == 3  // Mode C fill
        sPx   := cSlPx
        aR    := math.abs(anchor - sPx)
        pbBrk := na
        cPend     := false
        cPendBars := 0
        cDir      := 0
        if logOn
            log.info("C: FILLED @ {0} stop={1}", str.tostring(anchor, format.mintick), str.tostring(sPx, format.mintick))

    else  // Mode B (anchor already set in entry block)
        if na(aR)
            aR := stopAtrX * h2Atr
        if na(sPx)
            sPx := pSign == 1 ? anchor - aR : anchor + aR
        pbBrk := na

    if na(aR) or aR == 0
        aR := stopAtrX * h2Atr

// ╔══════════════════════════════════════════════════════════════════╗
// ║  LONG EXIT MANAGEMENT                                            ║
// ╚══════════════════════════════════════════════════════════════════╝
inLong = strategy.position_size > 0

if inLong
    bIn += 1
    hiS := na(hiS) ? high : math.max(hiS, high)

    usedR = (na(aR) or aR == 0) ? (stopAtrX * h2Atr) : aR
    r1 = high >= anchor + 1.0 * usedR
    r2 = high >= anchor + 2.0 * usedR

    // Add-on 1 @ +1R
    if r1 and not did1 and add1Pct > 0
        did1 := true
        strategy.entry("L_A1", strategy.long, qty=a1Qty)
        if lockOnAdd
            sPx := math.max(sPx, anchor + lockExtraR * usedR)
        if logOn
            log.info("ADD1 @+1R qty={0}", str.tostring(a1Qty, "#.####"))

    // Add-on 2 @ +2R
    if r2 and not did2 and add2Pct > 0 and (not add2Strong or strong)
        did2 := true
        strategy.entry("L_A2", strategy.long, qty=a2Qty)

    // Base stop
    bStop = anchor - usedR
    sPx := math.max(nz(sPx, bStop), bStop)

    // BE @ 1R with ATR buffer
    rBE = high >= anchor + beAfterR * usedR
    pBk = bePBBreak and not na(pbBrk) and high >= pbBrk
    if rBE or pBk
        beLvl = anchor + bePlusR * usedR + beAtrBuf * h2Atr
        sPx := math.max(sPx, beLvl)
        if not beOn
            beOn := true
            if doPartial and not partOK and rBE
                cQty2 = math.round(strategy.position_size * partPct / 100, 2)
                if cQty2 > 0
                    strategy.close("L", qty=cQty2, comment="PartTP@1R")
                    partOK := true

    // Chandelier trail + ATH tightening
    if high >= anchor + trailR * usedR
        tight = dAthPct <= nearAthPct
        cMult = tight ? tightAtrX : trailAtrX
        chand = hiS - cMult * h2Atr
        sPx := math.max(sPx, chand)

    // TimeStop
    if bIn >= tsBars and not r1
        strategy.close("L", comment="TimeStop")
        strategy.close("L_A1", comment="TimeStop")
        strategy.close("L_A2", comment="TimeStop")

    strategy.exit("XL",  "L",    stop=sPx)
    strategy.exit("XL1", "L_A1", stop=sPx)
    strategy.exit("XL2", "L_A2", stop=sPx)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  SHORT EXIT MANAGEMENT                                           ║
// ╚══════════════════════════════════════════════════════════════════╝
inShort = strategy.position_size < 0

if inShort
    bIn += 1
    loS := na(loS) ? low : math.min(loS, low)

    usedR = (na(aR) or aR == 0) ? (stopAtrX * h2Atr) : aR
    r1 = low <= anchor - 1.0 * usedR
    r2 = low <= anchor - 2.0 * usedR

    // Add-on 1 @ +1R
    if r1 and not did1 and add1Pct > 0
        did1 := true
        strategy.entry("S_A1", strategy.short, qty=a1Qty)
        if lockOnAdd
            sPx := math.min(sPx, anchor - lockExtraR * usedR)

    // Add-on 2 @ +2R
    if r2 and not did2 and add2Pct > 0 and (not add2Strong or strong)
        did2 := true
        strategy.entry("S_A2", strategy.short, qty=a2Qty)

    // Base stop
    bStop = anchor + usedR
    sPx := math.min(nz(sPx, bStop), bStop)

    // BE @ 1R with ATR buffer
    rBE = low <= anchor - beAfterR * usedR
    if rBE
        beLvl = anchor - bePlusR * usedR - beAtrBuf * h2Atr
        sPx := math.min(sPx, beLvl)
        if not beOn
            beOn := true
            if doPartial and not partOK
                cQty2 = math.round(math.abs(strategy.position_size) * partPct / 100, 2)
                if cQty2 > 0
                    strategy.close("S", qty=cQty2, comment="PartTP@1R")
                    partOK := true

    // Chandelier trail
    if low <= anchor - trailR * usedR
        chand = loS + trailAtrX * h2Atr
        sPx := math.min(sPx, chand)

    // TimeStop
    if bIn >= tsBars and not r1
        strategy.close("S", comment="TimeStop")
        strategy.close("S_A1", comment="TimeStop")
        strategy.close("S_A2", comment="TimeStop")

    strategy.exit("XS",  "S",    stop=sPx)
    strategy.exit("XS1", "S_A1", stop=sPx)
    strategy.exit("XS2", "S_A2", stop=sPx)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  RESET WHEN FLAT                                                 ║
// ╚══════════════════════════════════════════════════════════════════╝
if strategy.position_size == 0 and not cPend and not aPend
    anchor := na
    aR     := na
    sPx    := na
    hiS    := na
    loS    := na
    bIn    := 0
    did1   := false
    did2   := false
    beOn   := false
    partOK := false
    pbBrk  := na
    eSrc   := 0

// ╔══════════════════════════════════════════════════════════════════╗
// ║  PLOTS                                                           ║
// ╚══════════════════════════════════════════════════════════════════╝
plot(sPx, "Stop/Trail", color=color.new(color.red, 0), linewidth=2)
plot(h2Ema10, "H2 EMA10", color=color.new(color.blue, 0))
plot(h2Ema20, "H2 EMA20", color=color.new(color.orange, 0))

bgcolor(wLongOK and dLongOK ? color.new(color.green, 93) : wShortOK and dShortOK ? color.new(color.red, 93) : na)

plotshape(aReady, "A Ready", shape.diamond, location.belowbar, color.lime, size=size.small, text="A")
plotshape(bLong, "B Long", shape.triangleup, location.belowbar, color.aqua, size=size.tiny, text="B")
plotshape(bShort, "B Short", shape.triangledown, location.abovebar, color.fuchsia, size=size.tiny, text="B")
plotshape(fhDet, "FracHi", shape.triangledown, location.abovebar, color.new(color.green, 30), offset=-mC_fracLB, size=size.tiny)
plotshape(flDet, "FracLo", shape.triangleup, location.belowbar, color.new(color.red, 30), offset=-mC_fracLB, size=size.tiny)

// ╔══════════════════════════════════════════════════════════════════╗
// ║  INFO PANEL                                                      ║
// ╚══════════════════════════════════════════════════════════════════╝
var table pan = na
if showPanel and na(pan)
    pan := table.new(position.top_right, 2, 16, bgcolor=color.new(color.black, 80), frame_width=1, frame_color=color.gray)

if showPanel and not na(pan) and barstate.islast
    table.cell(pan, 0, 0, "Robin Unified", text_color=color.white, text_size=size.small)
    table.cell(pan, 1, 0, "v1.0", text_color=color.aqua, text_size=size.small)

    table.cell(pan, 0, 1, "W Trend", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 1, wLongOK ? "BULL" : wShortOK ? "BEAR" : "-", text_color=wLongOK ? color.lime : wShortOK ? color.red : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 2, "D Trend", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 2, dLongOK ? "BULL" : dShortOK ? "BEAR" : "-", text_color=dLongOK ? color.lime : dShortOK ? color.red : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 3, "Regime", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 3, strong ? "STRONG" : "NORMAL", text_color=strong ? color.lime : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 4, "ATH", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 4, str.tostring(wATH, format.mintick), text_color=color.yellow, text_size=size.tiny)

    table.cell(pan, 0, 5, "dist ATH%", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 5, str.tostring(dAthPct, "#.##"), text_color=color.yellow, text_size=size.tiny)

    table.cell(pan, 0, 6, "Mode A", text_color=color.white, text_size=size.tiny)
    aT = aDPb ? "PB ARM" : aDCross ? "CROSS" : aWkDeep ? "DEEP" : "OFF"
    table.cell(pan, 1, 6, aT, text_color=aDPb ? color.lime : aWkDeep ? color.yellow : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 7, "Mode B", text_color=color.white, text_size=size.tiny)
    bT = bLong ? "LONG" : bShort ? "SHORT" : "WAIT"
    table.cell(pan, 1, 7, bT, text_color=bLong ? color.lime : bShort ? color.red : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 8, "Mode C", text_color=color.white, text_size=size.tiny)
    cT = cPend ? "PENDING" : cWaiting ? "FRAC" : "OFF"
    table.cell(pan, 1, 8, cT, text_color=cPend ? color.yellow : cWaiting ? color.aqua : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 9, "Confluence", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 9, str.tostring(math.max(lModes, sModes)) + " modes", text_color=math.max(lModes, sModes) >= 2 ? color.lime : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 10, "Position", text_color=color.white, text_size=size.tiny)
    pT = inLong ? "LONG" : inShort ? "SHORT" : "FLAT"
    table.cell(pan, 1, 10, pT, text_color=inLong ? color.lime : inShort ? color.red : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 11, "Source", text_color=color.white, text_size=size.tiny)
    sT = eSrc == 1 ? "DeepPB(A)" : eSrc == 2 ? "Trend(B)" : eSrc == 3 ? "Frac(C)" : "-"
    table.cell(pan, 1, 11, sT, text_color=color.aqua, text_size=size.tiny)

    table.cell(pan, 0, 12, "Stop", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 12, not na(sPx) ? str.tostring(sPx, format.mintick) : "-", text_color=color.orange, text_size=size.tiny)

    table.cell(pan, 0, 13, "BE/Adds", text_color=color.white, text_size=size.tiny)
    addT = did2 ? "+1R+2R" : did1 ? "+1R" : "-"
    table.cell(pan, 1, 13, (beOn ? "BE " : "") + addT, text_color=beOn ? color.lime : color.gray, text_size=size.tiny)

    table.cell(pan, 0, 14, "ADX", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 14, str.tostring(tAdx, "#.#"), text_color=adxOK ? color.lime : color.red, text_size=size.tiny)

    table.cell(pan, 0, 15, "Bars In", text_color=color.white, text_size=size.tiny)
    table.cell(pan, 1, 15, str.tostring(bIn), text_color=color.white, text_size=size.tiny)
