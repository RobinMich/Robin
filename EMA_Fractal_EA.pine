// © Robin - EMA Fractal Expert Advisor
// Beschreibung: Multi-Timeframe EMA Strategie mit Fractal-basiertem Entry und Trailing Stop

//@version=6
strategy("EMA Fractal EA", overlay=true, default_qty_type=strategy.percent_of_equity, default_qty_value=2, initial_capital=10000, commission_type=strategy.commission.percent, commission_value=0.01, slippage=1)

// ============================================================================
// INPUTS - Einstellungen
// ============================================================================

// --- EMA Einstellungen ---
grp_ema = "EMA Einstellungen"
ema_fast_len   = input.int(10, "Schnelle EMA Länge", minval=1, group=grp_ema)
ema_mid_len    = input.int(20, "Mittlere EMA Länge", minval=1, group=grp_ema)
ema_slow_len   = input.int(50, "Langsame EMA Länge", minval=1, group=grp_ema)

// --- Fractal Einstellungen ---
grp_frac = "Fractal Einstellungen"
fractal_lookback    = input.int(2, "Fractal Lookback (Kerzen links/rechts)", minval=1, maxval=5, group=grp_frac)
max_candles_fractal = input.int(10, "Max Kerzen nach Cross für Fractal", minval=1, maxval=50, group=grp_frac)

// --- Filter: Abstand Fractal zu EMA20 ---
grp_filter = "Abstandsfilter Fractal zu EMA20"
use_distance_filter     = input.bool(true, "Abstandsfilter aktivieren", group=grp_filter)
max_distance_pct        = input.float(0.5, "Max Abstand Fractal zu EMA20 (%)", minval=0.01, maxval=5.0, step=0.05, group=grp_filter)

// --- Stop Loss Einstellungen ---
grp_sl = "Stop Loss Einstellungen"
sl_mode = input.string("Volles Fractal Low", "SL Modus", options=["Volles Fractal Low", "Halber Abstand Fractal Low"], group=grp_sl)

// --- Breakeven & Trailing ---
grp_trail = "Trailing Stop Einstellungen"
use_breakeven = input.bool(true, "Breakeven nach erstem Fractal-Durchbruch", group=grp_trail)

// ============================================================================
// MULTI-TIMEFRAME EMA BERECHNUNG
// ============================================================================

// --- Wöchentliche EMAs ---
w_ema10 = request.security(syminfo.tickerid, "W", ta.ema(close, ema_fast_len), lookahead=barmerge.lookahead_off)
w_ema20 = request.security(syminfo.tickerid, "W", ta.ema(close, ema_mid_len), lookahead=barmerge.lookahead_off)
w_ema50 = request.security(syminfo.tickerid, "W", ta.ema(close, ema_slow_len), lookahead=barmerge.lookahead_off)

// --- Tägliche EMAs ---
d_ema10 = request.security(syminfo.tickerid, "D", ta.ema(close, ema_fast_len), lookahead=barmerge.lookahead_off)
d_ema20 = request.security(syminfo.tickerid, "D", ta.ema(close, ema_mid_len), lookahead=barmerge.lookahead_off)

// --- H2 EMAs (Chart-Timeframe sollte H2 = 120 sein) ---
h2_ema10 = ta.ema(close, ema_fast_len)
h2_ema20 = ta.ema(close, ema_mid_len)

// ============================================================================
// SCANNER BEDINGUNGEN (alle müssen erfüllt sein)
// ============================================================================

// Woche: EMA10 > EMA20
cond_w_ema10_gt_ema20 = w_ema10 > w_ema20

// Woche: EMA20 > EMA50
cond_w_ema20_gt_ema50 = w_ema20 > w_ema50

// Tag: EMA10 > EMA20
cond_d_ema10_gt_ema20 = d_ema10 > d_ema20

// H2: EMA10 < EMA20 (Pullback-Bedingung)
cond_h2_ema10_lt_ema20 = h2_ema10 < h2_ema20

// Alle höheren Timeframe Bedingungen
htf_bullish = cond_w_ema10_gt_ema20 and cond_w_ema20_gt_ema50 and cond_d_ema10_gt_ema20

// ============================================================================
// H2: CANDLE CROSS ÜBER EMA20 ERKENNUNG
// ============================================================================

// Candle schließt über EMA20, nachdem sie darunter war
cross_above_ema20 = close > h2_ema20 and close[1] <= h2_ema20[1]

// Vollständiges Setup-Signal: alle Bedingungen + Cross
setup_signal = htf_bullish and cond_h2_ema10_lt_ema20 and cross_above_ema20

// ============================================================================
// FRACTAL ERKENNUNG (Williams Fractals)
// ============================================================================

// Oberes Fractal (Fractal High): Höchstes High mit 'fractal_lookback' Kerzen links und rechts
is_fractal_high(n) =>
    result = true
    for i = 1 to n
        if high[n] <= high[n - i] or high[n] <= high[n + i]
            result := false
    result

// Unteres Fractal (Fractal Low): Tiefstes Low mit 'fractal_lookback' Kerzen links und rechts
is_fractal_low(n) =>
    result = true
    for i = 1 to n
        if low[n] >= low[n - i] or low[n] >= low[n + i]
            result := false
    result

fractal_high_detected = is_fractal_high(fractal_lookback)
fractal_low_detected  = is_fractal_low(fractal_lookback)

fractal_high_price = fractal_high_detected ? high[fractal_lookback] : na
fractal_low_price  = fractal_low_detected  ? low[fractal_lookback]  : na

// ============================================================================
// ZUSTANDSMASCHINE: Signal → Fractal → Order → Trail
// ============================================================================

// Persistent Variablen
var int   bars_since_setup     = na       // Kerzen seit Setup-Signal
var bool  waiting_for_fractal  = false    // Warten auf erstes oberes Fractal
var float entry_price          = na       // Buystop Preis (Fractal High)
var float stop_loss_price      = na       // SL Preis
var float last_fractal_low     = na       // Letztes Fractal Low für SL/Trailing
var bool  order_pending        = false    // Buystop Order aktiv
var bool  breakeven_active     = false    // Breakeven bereits aktiviert
var float breakeven_price      = na       // Breakeven Level
var float trailing_sl          = na       // Trailing SL Level
var bool  first_fractal_break  = false    // Erster Fractal-Durchbruch für BE

// --- Letztes Fractal Low kontinuierlich tracken ---
if fractal_low_detected
    last_fractal_low := fractal_low_price

// ============================================================================
// SCHRITT 1: Setup-Signal erkannt → Warten auf Fractal
// ============================================================================

if setup_signal and not waiting_for_fractal and strategy.position_size == 0 and not order_pending
    waiting_for_fractal := true
    bars_since_setup    := 0

// Zähler hochzählen
if waiting_for_fractal
    bars_since_setup += 1

// Timeout: Nach max_candles_fractal Kerzen abbrechen
if waiting_for_fractal and bars_since_setup > max_candles_fractal
    waiting_for_fractal := false
    bars_since_setup    := na

// ============================================================================
// SCHRITT 2: Erstes oberes Fractal gefunden → Buystop Order setzen
// ============================================================================

if waiting_for_fractal and fractal_high_detected and bars_since_setup <= max_candles_fractal
    // Abstandsfilter prüfen
    dist_pct = math.abs(fractal_high_price - h2_ema20) / h2_ema20 * 100

    if not use_distance_filter or dist_pct <= max_distance_pct
        entry_price := fractal_high_price

        // SL berechnen
        if sl_mode == "Volles Fractal Low"
            stop_loss_price := last_fractal_low
        else
            // Halber Abstand: Entry - (Entry - last_fractal_low) / 2
            stop_loss_price := entry_price - (entry_price - last_fractal_low) / 2

        order_pending       := true
        waiting_for_fractal := false
        bars_since_setup    := na
        breakeven_active    := false
        first_fractal_break := false

// ============================================================================
// SCHRITT 3: Buystop Order ausführen
// ============================================================================

if order_pending and strategy.position_size == 0
    strategy.entry("BuyStop", strategy.long, stop=entry_price)
    strategy.exit("Initial SL", "BuyStop", stop=stop_loss_price)

// Order wurde gefüllt
if order_pending and strategy.position_size > 0
    order_pending := false
    trailing_sl   := stop_loss_price

// Buystop abbrechen wenn sich Bedingungen drastisch ändern (kein Bullish HTF mehr)
if order_pending and not htf_bullish
    strategy.cancel("BuyStop")
    order_pending := false
    entry_price   := na
    stop_loss_price := na

// ============================================================================
// SCHRITT 4: Trailing SL unter jedem H2 Fractal Low
// ============================================================================

if strategy.position_size > 0 and fractal_low_detected
    new_trail = fractal_low_price

    // Nur höher nachziehen (nie nach unten)
    if not na(new_trail) and (na(trailing_sl) or new_trail > trailing_sl)
        trailing_sl := new_trail
        strategy.exit("Trailing SL", "BuyStop", stop=trailing_sl)

// ============================================================================
// SCHRITT 5: Breakeven nach erstem oberen Fractal-Durchbruch (Close > Fractal High)
// ============================================================================

if strategy.position_size > 0 and use_breakeven and not breakeven_active
    // Suche nach einem neuen oberen Fractal nach Entry
    if fractal_high_detected
        first_fractal_break := false  // Reset, neues Fractal gefunden

    // Prüfe ob Close über dem letzten Fractal High schließt
    if not na(entry_price) and close > entry_price and not first_fractal_break
        first_fractal_break := true
        breakeven_active    := true
        breakeven_price     := entry_price

        // Trailing SL mindestens auf Breakeven setzen
        if na(trailing_sl) or breakeven_price > trailing_sl
            trailing_sl := breakeven_price
            strategy.exit("Breakeven SL", "BuyStop", stop=trailing_sl)

// ============================================================================
// PLOTS & VISUALISIERUNG
// ============================================================================

// EMAs auf Chart
plot(h2_ema10, "H2 EMA10", color=color.new(color.blue, 0), linewidth=1)
plot(h2_ema20, "H2 EMA20", color=color.new(color.orange, 0), linewidth=2)

// Fractal Markierungen
plotshape(fractal_high_detected, "Fractal High", shape.triangledown, location.abovebar, color.new(color.green, 30), offset=-fractal_lookback, size=size.tiny)
plotshape(fractal_low_detected, "Fractal Low", shape.triangleup, location.belowbar, color.new(color.red, 30), offset=-fractal_lookback, size=size.tiny)

// Setup-Signal
plotshape(setup_signal, "Setup Signal", shape.diamond, location.belowbar, color.new(color.lime, 0), size=size.small, text="SETUP")

// HTF Bedingungen als Hintergrund
bgcolor(htf_bullish ? color.new(color.green, 93) : na, title="HTF Bullish")
bgcolor(waiting_for_fractal ? color.new(color.yellow, 90) : na, title="Warte auf Fractal")

// Trailing SL Level anzeigen
plot(strategy.position_size > 0 ? trailing_sl : na, "Trailing SL", color=color.red, linewidth=2, style=plot.style_stepline)

// Entry Level anzeigen wenn Order pending
plot(order_pending ? entry_price : na, "Pending BuyStop", color=color.new(color.lime, 0), linewidth=1, style=plot.style_cross)

// ============================================================================
// INFO-TABELLE
// ============================================================================

var table info = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 80), frame_width=1, frame_color=color.gray)

if barstate.islast
    table.cell(info, 0, 0, "Bedingung", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "Status", text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "W: EMA10>20", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 1, cond_w_ema10_gt_ema20 ? "✓" : "✗", text_color=cond_w_ema10_gt_ema20 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 2, "W: EMA20>50", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 2, cond_w_ema20_gt_ema50 ? "✓" : "✗", text_color=cond_w_ema20_gt_ema50 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 3, "D: EMA10>20", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 3, cond_d_ema10_gt_ema20 ? "✓" : "✗", text_color=cond_d_ema10_gt_ema20 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 4, "H2: EMA10<20", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 4, cond_h2_ema10_lt_ema20 ? "✓" : "✗", text_color=cond_h2_ema10_lt_ema20 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 5, "Position", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 5, strategy.position_size > 0 ? "LONG" : "FLAT", text_color=strategy.position_size > 0 ? color.lime : color.gray, text_size=size.tiny)

    table.cell(info, 0, 6, "Trailing SL", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 6, strategy.position_size > 0 ? str.tostring(trailing_sl, format.mintick) : "-", text_color=color.orange, text_size=size.tiny)

    table.cell(info, 0, 7, "Breakeven", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 7, breakeven_active ? "AKTIV" : "INAKTIV", text_color=breakeven_active ? color.lime : color.gray, text_size=size.tiny)
