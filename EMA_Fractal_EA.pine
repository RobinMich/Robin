// https://mozilla.org/MPL/2.0/
// © Robin - EMA Fractal Expert Advisor v3.0
// Neu: 4 Trailing-Methoden, konfigurierbares Risiko, Partial-TP Modi, Range-Filter

//@version=6
strategy("EMA Fractal EA v3", overlay=true, default_qty_type=strategy.percent_of_equity,
         default_qty_value=1, initial_capital=10000,
         commission_type=strategy.commission.percent, commission_value=0.01, slippage=1)

// ============================================================================
// INPUTS
// ============================================================================

grp_ema = "EMA Einstellungen"
ema_fast_len = input.int(10, "Schnelle EMA", minval=1, group=grp_ema)
ema_mid_len  = input.int(20, "Mittlere EMA", minval=1, group=grp_ema)
ema_slow_len = input.int(50, "Langsame EMA", minval=1, group=grp_ema)

grp_dir = "Handelsrichtung"
trade_long  = input.bool(true, "Long Trades", group=grp_dir)
trade_short = input.bool(true, "Short Trades", group=grp_dir)

grp_frac = "Fractal"
fractal_lookback    = input.int(2, "Lookback", minval=1, maxval=5, group=grp_frac)
max_candles_fractal = input.int(10, "Max Kerzen für Fractal", minval=1, maxval=50, group=grp_frac)

grp_filter = "Abstandsfilter"
use_distance_filter = input.bool(true, "Aktivieren", group=grp_filter)
max_distance_pct    = input.float(0.5, "Max Abstand (%)", minval=0.01, maxval=5.0, step=0.05, group=grp_filter)

grp_sl = "Stop Loss"
sl_mode = input.string("Halber Abstand", "SL Modus", options=["Volles Fractal Low", "Halber Abstand"], group=grp_sl)

grp_risk = "Risiko Management"
risk_pct = input.float(1.0, "Risiko pro Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=grp_risk)

grp_trail = "Trailing Stop"
trail_mode     = input.string("ATR", "Trailing Methode", options=["Fractal", "ATR", "Chandelier", "EMA"], group=grp_trail)
atr_period     = input.int(14, "ATR Periode", minval=1, group=grp_trail)
atr_mult       = input.float(2.0, "ATR/Chandelier Multiplikator", minval=0.5, maxval=5.0, step=0.1, group=grp_trail)
ema_trail_len  = input.int(10, "EMA Trail Periode", minval=1, group=grp_trail)

grp_be = "Breakeven & Partial TP"
use_breakeven  = input.bool(true, "Breakeven aktivieren", group=grp_be)
partial_mode   = input.string("Breakeven", "Partial-TP Modus", options=["Breakeven", "Trail-Hit"], group=grp_be)
partial_tp_pct = input.float(50.0, "Anteil schließen (%)", minval=10, maxval=90, step=5, group=grp_be)

grp_time = "Zeitfilter"
use_session = input.bool(true, "Zeitfilter aktivieren", group=grp_time)
sess_start  = input.int(8, "Start (UTC)", minval=0, maxval=23, group=grp_time)
sess_end    = input.int(20, "Ende (UTC)", minval=0, maxval=23, group=grp_time)

// ============================================================================
// BERECHNUNGEN
// ============================================================================

// Session
cur_hour = hour(time, "UTC")
in_session = not use_session or (cur_hour >= sess_start and cur_hour < sess_end)

// HTF EMAs
w_ema10 = request.security(syminfo.tickerid, "W", ta.ema(close, ema_fast_len), lookahead=barmerge.lookahead_off)
w_ema20 = request.security(syminfo.tickerid, "W", ta.ema(close, ema_mid_len), lookahead=barmerge.lookahead_off)
w_ema50 = request.security(syminfo.tickerid, "W", ta.ema(close, ema_slow_len), lookahead=barmerge.lookahead_off)
d_ema10 = request.security(syminfo.tickerid, "D", ta.ema(close, ema_fast_len), lookahead=barmerge.lookahead_off)
d_ema20 = request.security(syminfo.tickerid, "D", ta.ema(close, ema_mid_len), lookahead=barmerge.lookahead_off)

// H2 EMAs
h2_ema10 = ta.ema(close, ema_fast_len)
h2_ema20 = ta.ema(close, ema_mid_len)
h2_ema_trail = ta.ema(close, ema_trail_len)

// ATR
atr_val = ta.atr(atr_period)

// Scanner
cond_w_bull = w_ema10 > w_ema20 and w_ema20 > w_ema50
cond_d_bull = d_ema10 > d_ema20
htf_bullish = cond_w_bull and cond_d_bull

cond_w_bear = w_ema10 < w_ema20 and w_ema20 < w_ema50
cond_d_bear = d_ema10 < d_ema20
htf_bearish = cond_w_bear and cond_d_bear

// Cross
cross_above = close > h2_ema20 and close[1] <= h2_ema20[1]
cross_below = close < h2_ema20 and close[1] >= h2_ema20[1]

setup_long  = trade_long  and htf_bullish and h2_ema10 < h2_ema20 and cross_above and in_session
setup_short = trade_short and htf_bearish and h2_ema10 > h2_ema20 and cross_below and in_session

// ============================================================================
// FRACTALS
// ============================================================================

is_frac_high(n) =>
    r = true
    for i = 1 to n
        if high[n] <= high[n - i] or high[n] <= high[n + i]
            r := false
    r

is_frac_low(n) =>
    r = true
    for i = 1 to n
        if low[n] >= low[n - i] or low[n] >= low[n + i]
            r := false
    r

fh_det = is_frac_high(fractal_lookback)
fl_det = is_frac_low(fractal_lookback)
fh_price = fh_det ? high[fractal_lookback] : na
fl_price = fl_det ? low[fractal_lookback] : na

// ============================================================================
// ZUSTANDSMASCHINE
// ============================================================================

var int   bars_setup    = na
var bool  waiting       = false
var int   trade_dir     = 0
var float entry_px      = na
var float sl_px         = na
var float last_fl       = na
var float last_fh       = na
var bool  order_pend    = false
var bool  be_active     = false
var float trail_sl      = na
var bool  partial_done  = false

if fl_det
    last_fl := fl_price
if fh_det
    last_fh := fh_price

// --- Setup ---
if setup_long and not waiting and strategy.position_size == 0 and not order_pend
    waiting   := true
    bars_setup := 0
    trade_dir := 1

if setup_short and not waiting and strategy.position_size == 0 and not order_pend
    waiting   := true
    bars_setup := 0
    trade_dir := -1

if waiting
    bars_setup += 1
if waiting and bars_setup > max_candles_fractal
    waiting   := false
    bars_setup := na
    trade_dir := 0

// --- Fractal → Order ---
if waiting and trade_dir == 1 and fh_det and bars_setup <= max_candles_fractal
    dp = math.abs(fh_price - h2_ema20) / h2_ema20 * 100
    if not use_distance_filter or dp <= max_distance_pct
        entry_px := fh_price
        if sl_mode == "Volles Fractal Low"
            sl_px := last_fl
        else
            sl_px := entry_px - (entry_px - last_fl) / 2
        if not na(sl_px) and sl_px < entry_px
            order_pend   := true
            waiting      := false
            bars_setup   := na
            be_active    := false
            partial_done := false

if waiting and trade_dir == -1 and fl_det and bars_setup <= max_candles_fractal
    dp = math.abs(fl_price - h2_ema20) / h2_ema20 * 100
    if not use_distance_filter or dp <= max_distance_pct
        entry_px := fl_price
        if sl_mode == "Volles Fractal Low"
            sl_px := last_fh
        else
            sl_px := entry_px + (last_fh - entry_px) / 2
        if not na(sl_px) and sl_px > entry_px
            order_pend   := true
            waiting      := false
            bars_setup   := na
            be_active    := false
            partial_done := false

// --- Order ausführen ---
if order_pend and strategy.position_size == 0
    // Positionsgröße basierend auf Risiko %
    risk_amount = strategy.equity * risk_pct / 100
    sl_distance = math.abs(entry_px - sl_px)
    qty = sl_distance > 0 ? risk_amount / sl_distance : 0

    if trade_dir == 1 and qty > 0
        strategy.entry("Long", strategy.long, qty=qty, stop=entry_px)
        strategy.exit("SL Long", "Long", stop=sl_px)
    else if trade_dir == -1 and qty > 0
        strategy.entry("Short", strategy.short, qty=qty, stop=entry_px)
        strategy.exit("SL Short", "Short", stop=sl_px)

if order_pend and strategy.position_size != 0
    order_pend := false
    trail_sl   := sl_px

if order_pend
    cancel_it = (trade_dir == 1 and not htf_bullish) or (trade_dir == -1 and not htf_bearish)
    if cancel_it
        strategy.cancel_all()
        order_pend := false
        entry_px   := na
        sl_px      := na
        trade_dir  := 0

// ============================================================================
// TRAILING SL (4 Methoden)
// ============================================================================

// --- LONG Trailing ---
if strategy.position_size > 0 and trade_dir == 1
    if trail_mode == "Fractal" and fl_det and not na(fl_price)
        if fl_price > trail_sl
            trail_sl := fl_price
    else if trail_mode == "ATR"
        new_sl = close - atr_val * atr_mult
        if new_sl > trail_sl
            trail_sl := new_sl
    else if trail_mode == "Chandelier"
        highest = ta.highest(high, atr_period)
        new_sl = highest - atr_val * atr_mult
        if new_sl > trail_sl
            trail_sl := new_sl
    else if trail_mode == "EMA" and not na(h2_ema_trail)
        if h2_ema_trail > trail_sl
            trail_sl := h2_ema_trail

    // SL Exit aktualisieren
    if partial_done
        strategy.exit("Trail Rest Long", "Long", stop=trail_sl)
    else
        strategy.exit("Trail Long", "Long", stop=trail_sl)

// --- SHORT Trailing ---
if strategy.position_size < 0 and trade_dir == -1
    if trail_mode == "Fractal" and fh_det and not na(fh_price)
        if fh_price < trail_sl
            trail_sl := fh_price
    else if trail_mode == "ATR"
        new_sl = close + atr_val * atr_mult
        if new_sl < trail_sl
            trail_sl := new_sl
    else if trail_mode == "Chandelier"
        lowest = ta.lowest(low, atr_period)
        new_sl = lowest + atr_val * atr_mult
        if new_sl < trail_sl
            trail_sl := new_sl
    else if trail_mode == "EMA" and not na(h2_ema_trail)
        if h2_ema_trail < trail_sl
            trail_sl := h2_ema_trail

    if partial_done
        strategy.exit("Trail Rest Short", "Short", stop=trail_sl)
    else
        strategy.exit("Trail Short", "Short", stop=trail_sl)

// ============================================================================
// BREAKEVEN & PARTIAL TP
// ============================================================================

// --- LONG ---
if strategy.position_size > 0 and trade_dir == 1 and use_breakeven and not be_active
    if not na(entry_px) and close > entry_px
        be_active := true
        if entry_px > trail_sl
            trail_sl := entry_px

        if partial_mode == "Breakeven" and not partial_done
            close_qty = math.round(strategy.position_size * partial_tp_pct / 100, 2)
            if close_qty > 0
                strategy.close("Long", qty=close_qty, comment="Partial TP")
                partial_done := true

        strategy.exit("BE Long", "Long", stop=trail_sl)

// --- SHORT ---
if strategy.position_size < 0 and trade_dir == -1 and use_breakeven and not be_active
    if not na(entry_px) and close < entry_px
        be_active := true
        if entry_px < trail_sl
            trail_sl := entry_px

        if partial_mode == "Breakeven" and not partial_done
            close_qty = math.round(math.abs(strategy.position_size) * partial_tp_pct / 100, 2)
            if close_qty > 0
                strategy.close("Short", qty=close_qty, comment="Partial TP")
                partial_done := true

        strategy.exit("BE Short", "Short", stop=trail_sl)

// ============================================================================
// RESET
// ============================================================================

if strategy.position_size == 0 and not order_pend
    trade_dir    := 0
    be_active    := false
    partial_done := false
    trail_sl     := na
    entry_px     := na
    sl_px        := na

// ============================================================================
// PLOTS
// ============================================================================

plot(h2_ema10, "EMA10", color.blue, 1)
plot(h2_ema20, "EMA20", color.orange, 2)
plot(trail_mode == "EMA" ? h2_ema_trail : na, "EMA Trail", color.new(color.purple, 50), 1)

plotshape(fh_det, "FH", shape.triangledown, location.abovebar, color.new(color.green, 30), offset=-fractal_lookback, size=size.tiny)
plotshape(fl_det, "FL", shape.triangleup, location.belowbar, color.new(color.red, 30), offset=-fractal_lookback, size=size.tiny)

plotshape(setup_long, "Long", shape.diamond, location.belowbar, color.lime, size=size.small, text="L")
plotshape(setup_short, "Short", shape.diamond, location.abovebar, color.fuchsia, size=size.small, text="S")

bgcolor(htf_bullish ? color.new(color.green, 93) : htf_bearish ? color.new(color.red, 93) : na)
bgcolor(not in_session and use_session ? color.new(color.gray, 95) : na)

plot(strategy.position_size != 0 ? trail_sl : na, "Trail SL", color.red, 2, plot.style_stepline)
plot(order_pend ? entry_px : na, "Pending", color.new(color.yellow, 0), 1, plot.style_cross)

// ============================================================================
// INFO-TABELLE
// ============================================================================

var table info = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 80), frame_width=1, frame_color=color.gray)

if barstate.islast
    table.cell(info, 0, 0, "Setting", text_color=color.white, text_size=size.small)
    table.cell(info, 1, 0, "Status", text_color=color.white, text_size=size.small)

    table.cell(info, 0, 1, "W: EMA Stack", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 1, cond_w_bull ? "BULL" : cond_w_bear ? "BEAR" : "-", text_color=cond_w_bull ? color.lime : cond_w_bear ? color.red : color.gray, text_size=size.tiny)

    table.cell(info, 0, 2, "D: EMA10>20", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 2, d_ema10 > d_ema20 ? "+" : "-", text_color=d_ema10 > d_ema20 ? color.lime : color.red, text_size=size.tiny)

    table.cell(info, 0, 3, "H2 Pullback", text_color=color.white, text_size=size.tiny)
    pb_txt = h2_ema10 < h2_ema20 ? "LONG" : h2_ema10 > h2_ema20 ? "SHORT" : "-"
    table.cell(info, 1, 3, pb_txt, text_color=color.white, text_size=size.tiny)

    table.cell(info, 0, 4, "Session", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 4, in_session ? "ON" : "OFF", text_color=in_session ? color.lime : color.gray, text_size=size.tiny)

    table.cell(info, 0, 5, "Trail Mode", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 5, trail_mode, text_color=color.aqua, text_size=size.tiny)

    table.cell(info, 0, 6, "Risk/Trade", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 6, str.tostring(risk_pct, "#.#") + "%", text_color=color.yellow, text_size=size.tiny)

    table.cell(info, 0, 7, "Position", text_color=color.white, text_size=size.tiny)
    pos_txt = strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT"
    pos_col = strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.gray
    table.cell(info, 1, 7, pos_txt, text_color=pos_col, text_size=size.tiny)

    table.cell(info, 0, 8, "Trail SL", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 8, strategy.position_size != 0 ? str.tostring(trail_sl, format.mintick) : "-", text_color=color.orange, text_size=size.tiny)

    table.cell(info, 0, 9, "Breakeven", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 9, be_active ? "ON" : "OFF", text_color=be_active ? color.lime : color.gray, text_size=size.tiny)

    table.cell(info, 0, 10, "Partial TP", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 10, partial_done ? str.tostring(partial_tp_pct, "#") + "% DONE" : "OPEN", text_color=partial_done ? color.lime : color.gray, text_size=size.tiny)

    table.cell(info, 0, 11, "ATR", text_color=color.white, text_size=size.tiny)
    table.cell(info, 1, 11, str.tostring(atr_val, format.mintick), text_color=color.aqua, text_size=size.tiny)
