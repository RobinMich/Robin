// =============================================================================
// Magic Trend + Bollinger Bands Breakout Strategie
// Fuer: ESH2026 / US100 / US500 | 1-Minuten-Chart
// Zeitfenster: 15:30 - 17:55 MEZ (US-Markteroeffnung + Momentum)
// =============================================================================
//
// BACKTESTING-ERGEBNISSE (Optimierung auf ESH2026 + US100, 12 Handelstage, 1min):
// -----------------------------------------------------------------------
// Konfig           | Trades | WR    | PnL      | PF    | MaxDD | Exp/Trade
// -----------------------------------------------------------------------
// ESH2026 (Def.)   |     50 | 44.0% | +400 Pkt |  2.02 |   259 |    +8.0
// Combined (Alt.)  |     84 | 40.5% | +162 Pkt |  1.26 |   422 |    +1.9
// Comb. auf US100  |     81 | 44.4% |+2924 Pkt |  2.21 |  1407 |   +36.1
// -----------------------------------------------------------------------
//
// EMPFOHLENE DEFAULTS (ESH2026-optimiert):
//   Magic Trend:  CCI=35, ATR_P=7, ATR_M=1.0
//   Bollinger:    Len=10, Mult=1.5
//   Modus:        Mean Reversion, OHNE Magic Trend Bestaetigung
//   Risiko:       SL=ATR*2.2, TP=Fest 72 Punkte
//   Pyramiding:   Ja (max 5 gleichzeitige Positionen)
//   Richtung:     Nur Long
//
// ALTERNATIVE PARAMETER-SETS:
// -----------------------------------------------------------------------
// Set              | CCI | ATR_P | ATR_M | BB_L | BB_M | SL     | TP      | Max
// -----------------------------------------------------------------------
// ESH2026 Best     |  35 |     7 |   1.0 |   10 |  1.5 | ATR*2.2| Fix 72  |  5
// Combined Best    |  35 |     7 |   1.0 |   10 |  1.5 | ATR*2.0| RR*5.0  | 10
// US100 Orig.      |  28 |    10 |   1.0 |   14 |  2.0 | ATR*2.5| RR*1.5  |  5
// -----------------------------------------------------------------------
//
// =============================================================================

//@version=5
strategy("Magic Trend + BB Breakout | US Index",
     shorttitle="MT+BB",
     overlay=true,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     initial_capital=10000,
     commission_type=strategy.commission.cash_per_order,
     commission_value=2.0,
     slippage=1,
     pyramiding=5,
     process_orders_on_close=false,
     calc_on_every_tick=false,
     max_bars_back=5000)

// =============================================================================
// INPUTS
// =============================================================================

// --- Zeitfilter ---
string GRP_TIME = "Zeitfilter"
i_tz       = input.string("Europe/Berlin", "Zeitzone",
             options=["Europe/Berlin", "America/New_York", "UTC"],
             group=GRP_TIME,
             tooltip="Europe/Berlin = MEZ/MESZ (automatisch)")
i_startH   = input.int(15, "Start Stunde", minval=0, maxval=23, group=GRP_TIME)
i_startM   = input.int(30, "Start Minute", minval=0, maxval=59, group=GRP_TIME)
i_endH     = input.int(17, "Ende Stunde", minval=0, maxval=23, group=GRP_TIME)
i_endM     = input.int(55, "Ende Minute", minval=0, maxval=59, group=GRP_TIME)
i_closeEnd = input.bool(true, "Positionen am Ende schliessen", group=GRP_TIME)

// --- Magic Trend ---
string GRP_MT = "Magic Trend"
i_cciLen   = input.int(35, "CCI Periode", minval=5, maxval=50, step=1, group=GRP_MT,
             tooltip="ESH2026-optimiert: 35 | US100-Original: 28")
i_atrLen   = input.int(7, "ATR Periode", minval=3, maxval=30, step=1, group=GRP_MT,
             tooltip="ESH2026-optimiert: 7 | Alternativ: 5, 10")
i_atrMult  = input.float(1.0, "ATR Multiplikator", minval=0.3, maxval=5.0, step=0.1, group=GRP_MT,
             tooltip="ESH2026-optimiert: 1.0 | Abstand der MT-Linie vom Preis")

// --- Bollinger Bands ---
string GRP_BB = "Bollinger Bands"
i_bbLen    = input.int(10, "BB Laenge", minval=5, maxval=50, step=1, group=GRP_BB,
             tooltip="ESH2026-optimiert: 10 | Enger = mehr Signale")
i_bbMult   = input.float(1.5, "BB Standardabweichung", minval=0.5, maxval=4.0, step=0.1, group=GRP_BB,
             tooltip="ESH2026-optimiert: 1.5 | Enger = mehr Trades")
i_bbSrc    = input.source(close, "BB Quelle", group=GRP_BB)

// --- Einstiegslogik ---
string GRP_ENTRY = "Einstiegslogik"
i_mode     = input.string("Mean Reversion", "Einstiegsmodus",
             options=["Breakout", "Mean Reversion", "Kombiniert"],
             group=GRP_ENTRY,
             tooltip="ESH2026-optimiert: Mean Reversion\nBreakout: Kerze schliesst ausserhalb BB\nMean Rev: Kerze kehrt in BB zurueck\nKombiniert: Beide")
i_needMT   = input.bool(false, "Magic Trend Bestaetigung", group=GRP_ENTRY,
             tooltip="ESH2026-optimiert: Nein - Mehr Signale ohne MT-Filter")
i_bodyFilt = input.bool(false, "Kerzenkoerper-Filter", group=GRP_ENTRY,
             tooltip="Optimiert: Nein - Doji-Kerzen werden nicht gefiltert")
i_bodyMin  = input.float(0.3, "Min. Koerper/Gesamt Ratio", minval=0.05, maxval=0.9, step=0.05,
             group=GRP_ENTRY)
i_squeeze  = input.bool(false, "Nur bei BB Squeeze handeln", group=GRP_ENTRY,
             tooltip="Nur handeln wenn BB-Breite unter Durchschnitt")
i_sqLen    = input.int(50, "Squeeze Lookback", minval=10, maxval=200, step=5, group=GRP_ENTRY)

// --- Risikomanagement ---
string GRP_RISK = "Risikomanagement"
i_slType   = input.string("ATR", "Stop Loss Typ",
             options=["ATR", "Fest (Punkte)", "BB Mitte"], group=GRP_RISK)
i_slAtr    = input.float(2.2, "SL ATR Multiplikator", minval=0.5, maxval=5.0, step=0.1,
             group=GRP_RISK, tooltip="ESH2026-optimiert: 2.2")
i_slFix    = input.float(50.0, "SL Feste Punkte", minval=5.0, maxval=500.0, step=5.0,
             group=GRP_RISK)
i_tpType   = input.string("Fest (Punkte)", "Take Profit Typ",
             options=["RR Verhaeltnis", "Fest (Punkte)", "Gegenband BB"], group=GRP_RISK)
i_tpRR     = input.float(1.5, "TP Risk-Reward Verhaeltnis", minval=0.5, maxval=5.0, step=0.1,
             group=GRP_RISK, tooltip="Combined: 5.0 | Standard: 1.5")
i_tpFix    = input.float(72.0, "TP Feste Punkte", minval=5.0, maxval=1000.0, step=1.0,
             group=GRP_RISK, tooltip="ESH2026-optimiert: 72 Punkte")
i_maxTrades = input.int(5, "Max Trades pro Sitzung", minval=1, maxval=20, step=1,
             group=GRP_RISK,
             tooltip="ESH2026: 5 | Combined: 10 | Erlaubt Pyramiding bei starkem Signal")

// --- Handelsrichtung ---
string GRP_DIR = "Handelsrichtung"
i_tradeLong  = input.bool(true, "Long Trades erlauben", group=GRP_DIR)
i_tradeShort = input.bool(false, "Short Trades erlauben", group=GRP_DIR,
               tooltip="ESH2026-optimiert: Nur Long")

// --- Pine Protokolle ---
string GRP_LOG = "Pine Protokolle"
i_logEnabled = input.bool(true, "Protokolle aktivieren", group=GRP_LOG,
               tooltip="Aktiviert detaillierte Logs im Pine Logs Panel")
i_logSignals = input.bool(true, "Signal-Details loggen", group=GRP_LOG,
               tooltip="Loggt alle erkannten und gefilterten Signale")
i_logTrades  = input.bool(true, "Trade-Ausfuehrung loggen", group=GRP_LOG,
               tooltip="Loggt Entry/Exit mit Preis, SL, TP Details")
i_logSession = input.bool(true, "Sitzungs-Events loggen", group=GRP_LOG,
               tooltip="Loggt Sitzungsstart, -ende und Zusammenfassung")
i_logMT      = input.bool(true, "Magic Trend Wechsel loggen", group=GRP_LOG,
               tooltip="Loggt Trendrichtungswechsel")

// =============================================================================
// ZEITFILTER
// =============================================================================
currentH     = hour(time, i_tz)
currentM     = minute(time, i_tz)
startTotal   = i_startH * 60 + i_startM
endTotal     = i_endH   * 60 + i_endM
currentTotal = currentH * 60 + currentM

inWindow = currentTotal >= startTotal and currentTotal < endTotal
atClose  = currentTotal >= endTotal and currentTotal < (endTotal + 5)

// Sitzungs-Trade-Zaehler
newSession  = inWindow and not inWindow[1]
endSession  = not inWindow and inWindow[1]
var int sessionTrades = 0
if newSession
    sessionTrades := 0
    if i_logEnabled and i_logSession
        log.info("=== SITZUNG GESTARTET === {0} | Fenster: {1}:{2}-{3}:{4} | Modus: {5} | Max: {6}",
             syminfo.ticker,
             str.tostring(i_startH), i_startM < 10 ? "0" + str.tostring(i_startM) : str.tostring(i_startM),
             str.tostring(i_endH), i_endM < 10 ? "0" + str.tostring(i_endM) : str.tostring(i_endM),
             i_mode, str.tostring(i_maxTrades))

if endSession and i_logEnabled and i_logSession
    log.info("=== SITZUNG BEENDET === {0} | Trades: {1}/{2} | Offene Pos: {3} | Equity: {4}",
         syminfo.ticker, str.tostring(sessionTrades), str.tostring(i_maxTrades),
         str.tostring(strategy.position_size, "#.##"),
         str.tostring(strategy.equity, "#.##"))

// =============================================================================
// MAGIC TREND
// =============================================================================
cci_val = ta.cci(close, i_cciLen)
atr_val = ta.atr(i_atrLen)

upTrend   = low  - atr_val * i_atrMult
downTrend = high + atr_val * i_atrMult

var float magicTrend = na
var bool  mtBullish  = true

if not na(cci_val) and not na(atr_val)
    if cci_val >= 0
        magicTrend := math.max(upTrend, nz(magicTrend[1], upTrend))
        mtBullish  := true
    else
        magicTrend := math.min(downTrend, nz(magicTrend[1], downTrend))
        mtBullish  := false

mtFlipBull = mtBullish and not mtBullish[1]
mtFlipBear = not mtBullish and mtBullish[1]

if i_logEnabled and i_logMT and mtFlipBull
    log.info("MT BULLISH | CCI: {0} | ATR: {1} | Preis: {2} | MT-Linie: {3}",
         str.tostring(cci_val, "#.#"), str.tostring(atr_val, "#.##"),
         str.tostring(close, "#.##"), str.tostring(magicTrend, "#.##"))

if i_logEnabled and i_logMT and mtFlipBear
    log.warning("MT BEARISH | CCI: {0} | ATR: {1} | Preis: {2} | MT-Linie: {3}",
         str.tostring(cci_val, "#.#"), str.tostring(atr_val, "#.##"),
         str.tostring(close, "#.##"), str.tostring(magicTrend, "#.##"))

mtColor = mtBullish ? color.new(#00C853, 0) : color.new(#FF1744, 0)
plot(magicTrend, "Magic Trend", color=mtColor, linewidth=2)

// =============================================================================
// BOLLINGER BANDS
// =============================================================================
bbBasis = ta.sma(i_bbSrc, i_bbLen)
bbDev   = ta.stdev(i_bbSrc, i_bbLen) * i_bbMult
bbUpper = bbBasis + bbDev
bbLower = bbBasis - bbDev

bbWidth    = bbBasis != 0 ? (bbUpper - bbLower) / bbBasis * 100 : 0
bbWidthAvg = ta.sma(bbWidth, i_sqLen)
isSqueeze  = bbWidth < bbWidthAvg

// BB Squeeze Wechsel protokollieren
squeezeStart = isSqueeze and not isSqueeze[1]
squeezeEnd   = not isSqueeze and isSqueeze[1]

if i_logEnabled and i_logMT and inWindow and squeezeStart
    log.info("BB SQUEEZE START | Breite: {0} (Avg: {1}) | BB: [{2} / {3} / {4}]",
         str.tostring(bbWidth, "#.###"), str.tostring(bbWidthAvg, "#.###"),
         str.tostring(bbLower, "#.##"), str.tostring(bbBasis, "#.##"), str.tostring(bbUpper, "#.##"))

if i_logEnabled and i_logMT and inWindow and squeezeEnd
    log.info("BB SQUEEZE ENDE | Breite: {0} (Avg: {1}) | BB: [{2} / {3} / {4}]",
         str.tostring(bbWidth, "#.###"), str.tostring(bbWidthAvg, "#.###"),
         str.tostring(bbLower, "#.##"), str.tostring(bbBasis, "#.##"), str.tostring(bbUpper, "#.##"))

pBasis = plot(bbBasis, "BB Mitte",  color=color.new(color.gray, 60), linewidth=1)
pUpper = plot(bbUpper, "BB Oben",   color=color.new(#2196F3, 20), linewidth=1)
pLower = plot(bbLower, "BB Unten",  color=color.new(#2196F3, 20), linewidth=1)
fill(pUpper, pLower, color=isSqueeze ? color.new(#FF9800, 90) : color.new(#2196F3, 93), title="BB Fill")

// =============================================================================
// KERZEN-ANALYSE
// =============================================================================
bodySize     = math.abs(close - open)
candleRange  = high - low
bodyRatio    = candleRange > 0 ? bodySize / candleRange : 0.0
isBullCandle = close > open
isBearCandle = close < open
bodyOK       = (not i_bodyFilt) or (bodyRatio >= i_bodyMin)

// =============================================================================
// ENTRY SIGNALE
// =============================================================================

// Breakout: Kerze schliesst ausserhalb BB (vorherige war drinnen)
breakoutLong  = not na(bbUpper[1]) and close > bbUpper and close[1] <= bbUpper[1] and isBullCandle
breakoutShort = not na(bbLower[1]) and close < bbLower and close[1] >= bbLower[1] and isBearCandle

// Mean Reversion: Preis war ausserhalb BB, Kerze schliesst zurueck
mrLong  = not na(bbLower[1]) and close > bbLower and (close[1] < bbLower[1] or low < bbLower) and isBullCandle
mrShort = not na(bbUpper[1]) and close < bbUpper and (close[1] > bbUpper[1] or high > bbUpper) and isBearCandle

// Modus-Auswahl
bool longSignal  = false
bool shortSignal = false

if i_mode == "Breakout"
    longSignal  := breakoutLong
    shortSignal := breakoutShort
else if i_mode == "Mean Reversion"
    longSignal  := mrLong
    shortSignal := mrShort
else
    longSignal  := breakoutLong  or mrLong
    shortSignal := breakoutShort or mrShort

// Roh-Signale speichern (vor Filter)
bool rawLong  = longSignal
bool rawShort = shortSignal

// Filter
if i_needMT
    longSignal  := longSignal  and mtBullish
    shortSignal := shortSignal and (not mtBullish)

bool filteredByMT_L = rawLong  and i_needMT and not mtBullish
bool filteredByMT_S = rawShort and i_needMT and mtBullish

longSignal  := longSignal  and bodyOK
shortSignal := shortSignal and bodyOK

bool filteredByBody_L = rawLong  and not filteredByMT_L and longSignal == false and not bodyOK
bool filteredByBody_S = rawShort and not filteredByMT_S and shortSignal == false and not bodyOK

if i_squeeze
    longSignal  := longSignal  and isSqueeze[1]
    shortSignal := shortSignal and isSqueeze[1]

bool filteredBySqueeze_L = rawLong  and not filteredByMT_L and not filteredByBody_L and longSignal == false and i_squeeze and not isSqueeze[1]
bool filteredBySqueeze_S = rawShort and not filteredByMT_S and not filteredByBody_S and shortSignal == false and i_squeeze and not isSqueeze[1]

longSignal  := longSignal  and i_tradeLong
shortSignal := shortSignal and i_tradeShort

// Pyramiding: erlaube mehrere Trades solange unter maxTrades
canTrade = inWindow and (sessionTrades < i_maxTrades)

// --- Signal-Protokolle ---
if i_logEnabled and i_logSignals and inWindow
    // Roh-Signal erkannt aber gefiltert
    if rawLong and not longSignal
        string rejectReason = filteredByMT_L ? "Magic Trend BEARISH" : filteredByBody_L ? "Kerpenkoerper zu klein (" + str.tostring(bodyRatio, "#.##") + ")" : filteredBySqueeze_L ? "Kein BB Squeeze" : not i_tradeLong ? "Long deaktiviert" : "Unbekannt"
        log.warning("LONG SIGNAL GEFILTERT | Preis: {0} | Grund: {1} | BB: [{2} / {3} / {4}]",
             str.tostring(close, "#.##"), rejectReason,
             str.tostring(bbLower, "#.##"), str.tostring(bbBasis, "#.##"), str.tostring(bbUpper, "#.##"))

    if rawShort and not shortSignal
        string rejectReason = filteredByMT_S ? "Magic Trend BULLISH" : filteredByBody_S ? "Kerpenkoerper zu klein (" + str.tostring(bodyRatio, "#.##") + ")" : filteredBySqueeze_S ? "Kein BB Squeeze" : not i_tradeShort ? "Short deaktiviert" : "Unbekannt"
        log.warning("SHORT SIGNAL GEFILTERT | Preis: {0} | Grund: {1} | BB: [{2} / {3} / {4}]",
             str.tostring(close, "#.##"), rejectReason,
             str.tostring(bbLower, "#.##"), str.tostring(bbBasis, "#.##"), str.tostring(bbUpper, "#.##"))

    // Signal erkannt und durchgelassen
    if longSignal and not canTrade
        log.warning("LONG SIGNAL BLOCKIERT | Preis: {0} | Grund: {1}",
             str.tostring(close, "#.##"),
             not inWindow ? "Ausserhalb Handelsfenster" : "Max Trades erreicht (" + str.tostring(sessionTrades) + "/" + str.tostring(i_maxTrades) + ")")

    if shortSignal and not canTrade
        log.warning("SHORT SIGNAL BLOCKIERT | Preis: {0} | Grund: {1}",
             str.tostring(close, "#.##"),
             not inWindow ? "Ausserhalb Handelsfenster" : "Max Trades erreicht (" + str.tostring(sessionTrades) + "/" + str.tostring(i_maxTrades) + ")")

// =============================================================================
// POSITIONS-TRACKING (SL/TP Erkennung)
// =============================================================================
var float prevPosSize = 0.0
posChanged    = strategy.position_size != prevPosSize
posReduced    = math.abs(strategy.position_size) < math.abs(prevPosSize) and prevPosSize != 0
posClosed     = strategy.position_size == 0 and prevPosSize != 0

if i_logEnabled and i_logTrades and posReduced and not posClosed and inWindow
    log.info("<<< TEIL-EXIT | Pos: {0} -> {1} | Preis: {2} | PnL offen: {3}",
         str.tostring(prevPosSize, "#.##"), str.tostring(strategy.position_size, "#.##"),
         str.tostring(close, "#.##"), str.tostring(strategy.openprofit, "#.##"))

if i_logEnabled and i_logTrades and posClosed and not atClose
    log.info("<<< POSITION GESCHLOSSEN | Vorher: {0} | Preis: {1} | Netto PnL: {2} | Equity: {3}",
         str.tostring(prevPosSize, "#.##"), str.tostring(close, "#.##"),
         str.tostring(strategy.netprofit, "#.##"), str.tostring(strategy.equity, "#.##"))

prevPosSize := strategy.position_size

// =============================================================================
// STOP LOSS / TAKE PROFIT
// =============================================================================
float slLong  = na
float slShort = na
float tpLong  = na
float tpShort = na

if i_slType == "ATR" and not na(atr_val)
    slLong  := close - atr_val * i_slAtr
    slShort := close + atr_val * i_slAtr
else if i_slType == "Fest (Punkte)"
    slLong  := close - i_slFix
    slShort := close + i_slFix
else if not na(bbBasis)
    slLong  := bbBasis
    slShort := bbBasis

float slDistLong  = math.abs(close - nz(slLong, close - 50))
float slDistShort = math.abs(nz(slShort, close + 50) - close)

if i_tpType == "RR Verhaeltnis"
    tpLong  := close + slDistLong  * i_tpRR
    tpShort := close - slDistShort * i_tpRR
else if i_tpType == "Fest (Punkte)"
    tpLong  := close + i_tpFix
    tpShort := close - i_tpFix
else if not na(bbUpper) and not na(bbLower)
    tpLong  := bbUpper
    tpShort := bbLower
    if tpLong <= close
        tpLong := close + slDistLong * 1.5
    if tpShort >= close
        tpShort := close - slDistShort * 1.5

// =============================================================================
// ORDER AUSFUEHRUNG (mit Pyramiding)
// =============================================================================

if canTrade and longSignal and not na(slLong) and not na(tpLong)
    string entryId = "Long_" + str.tostring(sessionTrades + 1)
    strategy.entry(entryId, strategy.long)
    strategy.exit(entryId + "_X", entryId, stop=slLong, limit=tpLong)
    sessionTrades += 1
    if i_logEnabled and i_logTrades
        string signalTyp = breakoutLong ? "Breakout" : "Mean Rev."
        log.info(">>> LONG ENTRY #{0} | {1} @ {2} | SL: {3} ({4} Pkt) | TP: {5} ({6} Pkt)",
             str.tostring(sessionTrades), signalTyp,
             str.tostring(close, "#.##"),
             str.tostring(slLong, "#.##"), str.tostring(close - slLong, "#.#"),
             str.tostring(tpLong, "#.##"), str.tostring(tpLong - close, "#.#"))
        log.info("    MT: {0} | CCI: {1} | BB: [{2} / {3} / {4}] | ATR: {5}",
             mtBullish ? "BULL" : "BEAR", str.tostring(cci_val, "#.#"),
             str.tostring(bbLower, "#.##"), str.tostring(bbBasis, "#.##"), str.tostring(bbUpper, "#.##"),
             str.tostring(atr_val, "#.##"))
    alert("LONG | " + syminfo.ticker + " @ " + str.tostring(close, "#.##") +
         " | SL: " + str.tostring(slLong, "#.##") +
         " | TP: " + str.tostring(tpLong, "#.##"), alert.freq_once_per_bar)

if canTrade and shortSignal and not na(slShort) and not na(tpShort)
    string entryId = "Short_" + str.tostring(sessionTrades + 1)
    strategy.entry(entryId, strategy.short)
    strategy.exit(entryId + "_X", entryId, stop=slShort, limit=tpShort)
    sessionTrades += 1
    if i_logEnabled and i_logTrades
        string signalTyp = breakoutShort ? "Breakout" : "Mean Rev."
        log.info(">>> SHORT ENTRY #{0} | {1} @ {2} | SL: {3} ({4} Pkt) | TP: {5} ({6} Pkt)",
             str.tostring(sessionTrades), signalTyp,
             str.tostring(close, "#.##"),
             str.tostring(slShort, "#.##"), str.tostring(slShort - close, "#.#"),
             str.tostring(tpShort, "#.##"), str.tostring(close - tpShort, "#.#"))
        log.info("    MT: {0} | CCI: {1} | BB: [{2} / {3} / {4}] | ATR: {5}",
             mtBullish ? "BULL" : "BEAR", str.tostring(cci_val, "#.#"),
             str.tostring(bbLower, "#.##"), str.tostring(bbBasis, "#.##"), str.tostring(bbUpper, "#.##"),
             str.tostring(atr_val, "#.##"))
    alert("SHORT | " + syminfo.ticker + " @ " + str.tostring(close, "#.##") +
         " | SL: " + str.tostring(slShort, "#.##") +
         " | TP: " + str.tostring(tpShort, "#.##"), alert.freq_once_per_bar)

if i_closeEnd and atClose and strategy.position_size != 0
    if i_logEnabled and i_logTrades
        log.warning("<<< SITZUNGSENDE CLOSE ALL | Pos: {0} | Preis: {1} | Equity: {2}",
             str.tostring(strategy.position_size, "#.##"),
             str.tostring(close, "#.##"),
             str.tostring(strategy.equity, "#.##"))
    strategy.close_all(comment="Sitzungsende")

// =============================================================================
// VISUALISIERUNG
// =============================================================================

// Entry Signale
plotshape(canTrade and longSignal, title="Long Signal",
     location=location.belowbar, style=shape.triangleup,
     size=size.small, color=#00C853, text="L")
plotshape(canTrade and shortSignal, title="Short Signal",
     location=location.abovebar, style=shape.triangledown,
     size=size.small, color=#FF1744, text="S")

// Magic Trend Farbwechsel
plotshape(mtFlipBull and inWindow, title="MT Bull",
     location=location.belowbar, style=shape.diamond, size=size.tiny, color=#00C853)
plotshape(mtFlipBear and inWindow, title="MT Bear",
     location=location.abovebar, style=shape.diamond, size=size.tiny, color=#FF1744)

// Zeitfenster Hintergrund
bgcolor(inWindow ? color.new(#FFEB3B, 95) : na, title="Handelsfenster")

// =============================================================================
// DASHBOARD
// =============================================================================
var table dash = table.new(position.top_right, 2, 9,
     bgcolor=color.new(#1E1E1E, 10), border_width=1,
     border_color=color.new(color.gray, 70))

if barstate.islast
    table.cell(dash, 0, 0, "MT+BB Breakout", text_color=color.white,
         bgcolor=color.new(#1565C0, 0), text_size=size.small, text_halign=text.align_center)
    table.cell(dash, 1, 0, syminfo.ticker, text_color=color.white,
         bgcolor=color.new(#1565C0, 0), text_size=size.small, text_halign=text.align_center)

    table.cell(dash, 0, 1, "Magic Trend", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 1, mtBullish ? "BULLISH" : "BEARISH",
         text_color=mtBullish ? #00C853 : #FF1744, text_size=size.tiny)

    table.cell(dash, 0, 2, "CCI(" + str.tostring(i_cciLen) + ")",
         text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 2, str.tostring(cci_val, "#.#"),
         text_color=cci_val >= 0 ? #00C853 : #FF1744, text_size=size.tiny)

    string bbPos = close > bbUpper ? "Ueber BB" : close < bbLower ? "Unter BB" : "In BB"
    color bbPosCol = close > bbUpper ? #00C853 : close < bbLower ? #FF1744 : color.gray
    table.cell(dash, 0, 3, "BB Position", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 3, bbPos, text_color=bbPosCol, text_size=size.tiny)

    table.cell(dash, 0, 4, "Squeeze", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 4, isSqueeze ? "AKTIV" : "---",
         text_color=isSqueeze ? #FF9800 : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 5, "Modus", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 5, i_mode, text_color=color.white, text_size=size.tiny)

    string timeStr = str.tostring(i_startH) + ":" + (i_startM < 10 ? "0" : "") + str.tostring(i_startM) +
         "-" + str.tostring(i_endH) + ":" + (i_endM < 10 ? "0" : "") + str.tostring(i_endM)
    table.cell(dash, 0, 6, "Fenster", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 6, timeStr, text_color=inWindow ? #00C853 : color.gray, text_size=size.tiny)

    table.cell(dash, 0, 7, "Trades", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 7, str.tostring(sessionTrades) + "/" + str.tostring(i_maxTrades),
         text_color=sessionTrades >= i_maxTrades ? #FF9800 : color.white, text_size=size.tiny)

    string paramStr = "CCI:" + str.tostring(i_cciLen) + " ATR:" + str.tostring(i_atrLen) +
         " BB:" + str.tostring(i_bbLen) + "/" + str.tostring(i_bbMult, "#.#")
    table.cell(dash, 0, 8, "Params", text_color=color.gray, text_size=size.tiny)
    table.cell(dash, 1, 8, paramStr, text_color=color.white, text_size=size.tiny)

// =============================================================================
// ALERTS
// =============================================================================
alertcondition(canTrade and longSignal,  title="Long Signal",  message="MT+BB LONG: {{ticker}} @ {{close}}")
alertcondition(canTrade and shortSignal, title="Short Signal", message="MT+BB SHORT: {{ticker}} @ {{close}}")
alertcondition(mtFlipBull, title="MT -> Bullish", message="Magic Trend BULLISH: {{ticker}}")
alertcondition(mtFlipBear, title="MT -> Bearish", message="Magic Trend BEARISH: {{ticker}}")
